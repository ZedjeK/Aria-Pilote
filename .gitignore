# Python
__pycache__/
*.pyc
.venv/

# Données personnelles et réglages de la machine
data/
/config.json
models/

# Binaires téléchargés par les scripts d'installation
engines/
.build_cache/

# SearXNG : code téléchargé, dépendances et configuration (contient une clé secrète)
services/searxng/src/
services/searxng/.venv/
services/searxng/site-packages/
services/searxng/settings.yml
services/searxng/service.json

# Compétences perso de l'utilisateur (les intégrées sont dans aria_pilote/skills/)
/skills/

# Sous-agents perso de l'utilisateur (les intégrés sont dans aria_pilote/agents/)
/agents/

# Hooks globaux de l'utilisateur
/hooks.json

# Serveurs MCP de l'utilisateur (peuvent contenir des jetons)
/mcp.json

# Résultats du banc d'essai (propres à chaque machine)
bench/results/
